# Внутрішні origin інстансів API для серверного проксі. Інстанс, що завис чи відмовив,
# обходиться від 30 с до 5 хв, поки поруч є справний.
API_URLS=http://api:3000,http://api-2:3000
API_TIMEOUT_MS=15000
# Локальний Compose задає origin та режим cookie через кореневий .env.
# За TLS задайте публічний HTTPS origin та COOKIE_SECURE=true.
PUBLIC_ORIGIN=http://localhost:3001
COOKIE_SECURE=false
FRONTEND_TRUST_PROXY=false
