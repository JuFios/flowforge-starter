# Скопіюйте у .env для локального запуску поза docker (і замініть хост БД на localhost).
# docker-compose бере цей файл як основу, але перевизначає NODE_ENV=production і ADMIN_TOKEN
# (токен — з .env у корені репозиторію, див. README «Запуск»).

# development | test | production. У production приклади секретів (ADMIN_TOKEN нижче) заборонені.
NODE_ENV=development
# Порт HTTP API
PORT=3000
# Службовий порт API лише для /metrics (не публікується назовні; у compose — api:3200)
METRICS_PORT=3200
# Найбільше JSON-тіло HTTP-запиту, байт (69632..1048576); більше — 413
HTTP_BODY_LIMIT=102400
# Вихідний запит воркера: від DNS до останнього байта. Додаткові внутрішні CIDR через кому.
HTTP_STEP_TIMEOUT_MS=15000
HTTP_RESPONSE_BYTES=1048576
HTTP_DENY_CIDRS=
# Підключення процесу до Postgres його власною роллю без BYPASSRLS (створює `npm run db:provision`):
#   API    — postgres://flowforge_api:<API_DB_PASSWORD>@<хост>:5432/flowforge
#   воркер — postgres://flowforge_worker:<WORKER_DB_PASSWORD>@<хост>:5432/flowforge
# Секрет: задається окремо для кожного процесу (compose — environment сервісу), тому тут закоментовано.
# Облікові дані власника схеми (MIGRATION_DATABASE_URL) API й воркеру передавати заборонено.
# DATABASE_URL=
# Таймаут встановлення з'єднання з Postgres, мс (100..60000)
DB_CONNECT_TIMEOUT_MS=5000
# Межа одного SQL-запиту і простою відкритої транзакції, мс (100..600000); на міграції не діє
DB_STATEMENT_TIMEOUT_MS=30000
# Токен службових ендпоінтів /tenants (мінімум 12 символів). Обов'язковий лише для API; воркер його
# не отримує. Секрет: для локальної розробки підійде change-me-admin, у NODE_ENV=production такі
# значення (і очевидні заглушки) не пройдуть валідацію.
# ADMIN_TOKEN=
# Ліміти за IP-адресою клієнта (лічильники в Postgres, спільні для інстансів API):
# запитів до /tenants за вікно (1..10000; вікно 1000..3600000 мс)
ADMIN_RATE_LIMIT=30
ADMIN_RATE_WINDOW_MS=60000
# невдалих автентифікацій (невірний x-api-key чи підпис webhook-а) за вікно; понад це — 429
AUTH_FAILURE_RATE_LIMIT=30
AUTH_FAILURE_RATE_WINDOW_MS=60000
# Довіра до X-Forwarded-For для IP клієнта: false (API без проксі попереду), кількість
# проксі-переходів 1..10 або перелік IP/підмереж проксі через кому. Ліміти тенантів (частота,
# черга, одночасні задачі) — у db:provision (TENANT_*, кореневий .env.example) і адмін-API.
TRUST_PROXY=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Кількість паралельних циклів обробки задач в одному воркері (1..64)
WORKER_CONCURRENCY=4
# Найбільше з'єднань із Postgres в одному процесі (5..1000), не менше за WORKER_CONCURRENCY + 4.
# Сума пулів усіх процесів (API + воркери) має вміщатися в max_connections Postgres.
DB_POOL_SIZE=10
# Порт службового HTTP воркера: /health, /ready, /metrics
WORKER_HTTP_PORT=3100
# Lease задачі, мс (500..600000). Воркер продовжує його кожну третину; задачу воркера, що не
# продовжив вчасно (упав, завис), reaper повертає в чергу приблизно через цей час.
JOB_LEASE_MS=30000
# Пауза між перевірками порожньої черги, мс (10..60000), з випадковим відхиленням ±50%
WORKER_POLL_INTERVAL_MS=500
# Спроб на кожен крок виконання (1..100); вичерпані повторювані помилки — стан dead
JOB_MAX_ATTEMPTS=5
# Затримка повтору задачі після невдалої спроби: випадкова між BASE і min(MAX, BASE·2^спроба), мс
JOB_BACKOFF_BASE_MS=1000
JOB_BACKOFF_MAX_MS=300000
# Під час завершення воркер стільки чекає на задачі в роботі, мс (0..600000), а потім повертає
# їх у чергу. Менше за stop_grace_period воркера в docker-compose.yml (30 с).
WORKER_SHUTDOWN_GRACE_MS=20000
# Скільки днів зберігати завершені задачі (done/failed/dead) у таблиці jobs (1..3650);
# виконання й кроки не видаляються
JOB_RETENTION_DAYS=30
# Скільки днів зберігати історію завершених виконань (з їхніми кроками й задачами), 0..3650;
# 0 — зберігати завжди (історію тенанта без явного рішення не видаляємо)
EXECUTION_RETENTION_DAYS=0
# Як часто кожен воркер видаляє старі завершені задачі, мс (1000..2147483647), з відхиленням ±50%
JOB_CLEANUP_INTERVAL_MS=3600000

# Період тіку планувальника cron, мс (100..60000): без перешкод вчасний момент обробляється на
# найближчому тіку; зайнятий рядок, повна черга чи квота outbox і простій відкладають спрацювання.
SCHEDULER_TICK_MS=30000
# Момент розкладу, старший за стільки мс на час обробки, — пропущений (простій, БД недоступна,
# повна черга) і обробляється за політикою workflow `missedRunPolicy` (1000..2147483647,
# не менше за SCHEDULER_TICK_MS).
SCHEDULER_MISFIRE_GRACE_MS=60000

# Вихідні сповіщення (README 3.3.9), надсилає воркер. Циклів доставки на воркер (0..64; 0 — вимкнено),
# одночасних спроб одного тенанта в кластері (1..64), пауза опитування, мс (10..60000).
OUTBOX_CONCURRENCY=4
OUTBOX_TENANT_IN_FLIGHT=2
OUTBOX_POLL_INTERVAL_MS=1000
# Таймаут однієї спроби, мс (100..60000, транспорт бере мінімум із HTTP_STEP_TIMEOUT_MS).
OUTBOX_HTTP_TIMEOUT_MS=10000
# Backoff між спробами, мс: експоненційний з jitter від BASE до MAX. Спроб без ліміту — недоставлену
# подію не видаляють, а повторюють не рідше за MAX.
OUTBOX_BACKOFF_BASE_MS=5000
OUTBOX_BACKOFF_MAX_MS=3600000
# Скільки днів зберігати доставлені або явно скасовані тенантом події (1..3650).
OUTBOX_RETENTION_DAYS=7

# Лише для інтеграційних тестів (npm run test:integration): окрема БД із суфіксом _test,
# яку тести очищають повністю. За замовчуванням — postgres://flowforge:flowforge@localhost:5432/flowforge_test
# TEST_DATABASE_URL=postgres://flowforge:flowforge@localhost:5432/flowforge_test

# Абсолютний строк сесії та межа активних сесій тенанта.
SESSION_TTL_MS=28800000
SESSION_MAX_PER_TENANT=100
REALTIME_TICKET_TTL_MS=30000
REALTIME_MAX_CONNECTIONS=256
REALTIME_MAX_CONNECTIONS_PER_TENANT=32
