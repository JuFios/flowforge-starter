# Скопіюйте у .env для локального запуску поза docker (і замініть хост БД на localhost).
# docker-compose використовує цей файл як є.

# development | test | production
NODE_ENV=production
# Порт HTTP API
PORT=3000
# Службовий порт API лише для /metrics (не публікується назовні; у compose — api:3200)
METRICS_PORT=3200
# Підключення до Postgres (у docker-compose хост — postgres)
DATABASE_URL=postgres://flowforge:flowforge@postgres:5432/flowforge
# Токен службового ендпоінта POST /tenants (мінімум 12 символів). Обов'язково змініть.
ADMIN_TOKEN=change-me-admin
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Кількість паралельних циклів обробки задач в одному воркері (1..64)
WORKER_CONCURRENCY=4
# Порт службового HTTP воркера: /health, /ready, /metrics
WORKER_HTTP_PORT=3100

# Період тіку планувальника cron, мс (100..2147483647). Верхня межа тимчасова — лише ліміт
# таймерів Node; розумні значення — секунди або десятки секунд.
SCHEDULER_TICK_MS=30000

# Лише для інтеграційних тестів (npm run test:integration): окрема БД із суфіксом _test,
# яку тести очищають повністю. За замовчуванням — postgres://flowforge:flowforge@localhost:5432/flowforge_test
# TEST_DATABASE_URL=postgres://flowforge:flowforge@localhost:5432/flowforge_test
