# Скопіюйте у .env для локального запуску поза docker (і замініть хост БД на localhost).
# docker-compose бере цей файл як основу, але перевизначає NODE_ENV=production і ADMIN_TOKEN
# (токен — з .env у корені репозиторію, див. README «Запуск»).

# development | test | production. У production приклади секретів (ADMIN_TOKEN нижче) заборонені.
NODE_ENV=development
# Порт HTTP API
PORT=3000
# Службовий порт API лише для /metrics (не публікується назовні; у compose — api:3200)
METRICS_PORT=3200
# Підключення до Postgres (у docker-compose хост — postgres)
DATABASE_URL=postgres://flowforge:flowforge@postgres:5432/flowforge
# Таймаут встановлення з'єднання з Postgres, мс (100..60000)
DB_CONNECT_TIMEOUT_MS=5000
# Межа одного SQL-запиту і простою відкритої транзакції, мс (100..600000); на міграції не діє
DB_STATEMENT_TIMEOUT_MS=30000
# Токен службового ендпоінта POST /tenants (мінімум 12 символів). Лише для локальної розробки:
# у NODE_ENV=production це значення (і очевидні заглушки) не пройде валідацію.
ADMIN_TOKEN=change-me-admin
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Кількість паралельних циклів обробки задач в одному воркері (1..64)
WORKER_CONCURRENCY=4
# Порт службового HTTP воркера: /health, /ready, /metrics
WORKER_HTTP_PORT=3100
# Lease задачі, мс (500..600000). Воркер продовжує його кожну третину; задачу воркера, що не
# продовжив вчасно (упав, завис), reaper повертає в чергу приблизно через цей час.
JOB_LEASE_MS=30000
# Пауза між перевірками порожньої черги, мс (10..60000), з випадковим відхиленням ±50%
WORKER_POLL_INTERVAL_MS=500

# Період тіку планувальника cron, мс (100..2147483647). Верхня межа тимчасова — лише ліміт
# таймерів Node; розумні значення — секунди або десятки секунд.
SCHEDULER_TICK_MS=30000

# Лише для інтеграційних тестів (npm run test:integration): окрема БД із суфіксом _test,
# яку тести очищають повністю. За замовчуванням — postgres://flowforge:flowforge@localhost:5432/flowforge_test
# TEST_DATABASE_URL=postgres://flowforge:flowforge@localhost:5432/flowforge_test
