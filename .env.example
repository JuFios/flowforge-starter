# Налаштування docker compose. Локально: `cp .env.example .env && docker compose up --build`.
# Значення нижче — заглушки лише для локальної розробки: вони дозволені, поки NODE_ENV не
# production, а порти compose слухають тільки 127.0.0.1 (PUBLISH_ADDRESS).
#
# Для production (README, «Запуск»):
#   NODE_ENV=production — заглушки зупиняють migrate, API й воркери;
#   кожен секрет — випадкове значення, напр. `openssl rand -hex 24`;
#   PUBLISH_ADDRESS — адреса, на якій compose відкриває API й інтерфейс (за TLS-проксі).
# Кожен сервіс отримує лише свої секрети. Решта конфігурації — у apps/api/.env.example і
# apps/frontend/.env.example.
NODE_ENV=development
PUBLISH_ADDRESS=127.0.0.1

# Токен службових ендпоінтів /tenants. Лише для API.
ADMIN_TOKEN=local-dev-admin-token-change-me
# Пароль власника схеми — суперкористувача Postgres `flowforge`. Отримують лише postgres і migrate.
# Діє лише під час створення порожнього тому pgdata (docs/operations.md, «Оновлення з попередньої версії»).
POSTGRES_PASSWORD=localdevpostgrespasswordchangeme
# Паролі runtime-ролей БД без BYPASSRLS: flowforge_api (API) і flowforge_worker (воркер).
# Лише латинські літери й цифри, щонайменше 24 символи (потрапляють у URL підключення).
API_DB_PASSWORD=localdevapipasswordchangeme0000
WORKER_DB_PASSWORD=localdevworkerpasswordchangeme00

# Додаткові внутрішні CIDR розгортання, межі вихідних запитів воркера.
HTTP_DENY_CIDRS=
HTTP_STEP_TIMEOUT_MS=15000
HTTP_RESPONSE_BYTES=1048576

# Необов'язково: ліміти тенантів за замовчуванням (без значення — як нижче). Застосовує крок
# migrate (db:provision) під час кожного `docker compose up`; перевизначення окремого тенанта —
# адмін-API (docs/architecture.md, «Контракт лімітів»).
# TENANT_MAX_RUNNING=10
# TENANT_MAX_QUEUE_SIZE=100000
# TENANT_MAX_WORKFLOWS=1000
# Недоставлені сповіщення разом із незавершеними виконаннями тенанта (квота outbox).
# TENANT_MAX_OUTBOX_EVENTS=200000
# TENANT_RATE_LIMIT=600
# TENANT_RATE_WINDOW_MS=60000
# TENANT_WEBHOOK_RATE_LIMIT=600
# TENANT_WEBHOOK_RATE_WINDOW_MS=60000

# Адреса браузерного інтерфейсу. Для TLS задайте HTTPS origin і COOKIE_SECURE=true.
PUBLIC_ORIGIN=http://localhost:3001
COOKIE_SECURE=false
# FRONTEND_TRUST_PROXY=false
# FLOWFORGE_SUBNET=172.30.61.0/24
# FRONTEND_IP=172.30.61.10
