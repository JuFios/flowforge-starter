# Змінні для docker-compose. Скопіюйте у .env (поруч із docker-compose.yml) і задайте значення:
#   printf 'ADMIN_TOKEN=%s\n' "$(openssl rand -hex 24)" > .env
# Решта конфігурації сервісів — у apps/api/.env.example і apps/frontend/.env.example.

# Токен службового ендпоінта POST /tenants. Обов'язковий; compose запускає API з NODE_ENV=production,
# де приклади й очевидні заглушки (change-me…, password…, «aaaa…») не проходять валідацію.
ADMIN_TOKEN=
