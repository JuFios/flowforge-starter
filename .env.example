# Секрети для docker-compose. Створіть .env (поруч із docker-compose.yml) з правами 0600 до запису
# секретів і згенеруйте значення:
#   touch .env && chmod 600 .env
#   for v in ADMIN_TOKEN POSTGRES_PASSWORD API_DB_PASSWORD WORKER_DB_PASSWORD; do
#     printf '%s=%s\n' "$v" "$(openssl rand -hex 24)"; done > .env
# Кожен сервіс compose отримує лише свої секрети (README, «Запуск»). Решта конфігурації — у
# apps/api/.env.example і apps/frontend/.env.example.

# Токен службових ендпоінтів /tenants. Лише для API; у NODE_ENV=production приклади й очевидні
# заглушки (change-me…, password…, «aaaa…») не проходять валідацію.
ADMIN_TOKEN=
# Пароль власника схеми — суперкористувача Postgres `flowforge`. Отримують лише postgres і migrate.
# Діє лише під час створення порожнього тому pgdata (див. README, «Оновлення з попередньої версії»).
POSTGRES_PASSWORD=
# Додаткові внутрішні CIDR розгортання, межі вихідних запитів воркера.
HTTP_DENY_CIDRS=
HTTP_STEP_TIMEOUT_MS=15000
HTTP_RESPONSE_BYTES=1048576
# Паролі runtime-ролей БД без BYPASSRLS: flowforge_api (API) і flowforge_worker (воркер).
# Лише латинські літери й цифри, щонайменше 24 символи (потрапляють у URL підключення).
API_DB_PASSWORD=
WORKER_DB_PASSWORD=

# Необов'язково: ліміти тенантів за замовчуванням (без значення — як нижче). Застосовує крок
# migrate (db:provision) під час кожного `docker compose up`; перевизначення окремого тенанта —
# адмін-API (README, «Контракт лімітів»).
# TENANT_MAX_RUNNING=10
# TENANT_MAX_QUEUE_SIZE=100000
# TENANT_MAX_WORKFLOWS=1000
# TENANT_RATE_LIMIT=600
# TENANT_RATE_WINDOW_MS=60000
# TENANT_WEBHOOK_RATE_LIMIT=600
# TENANT_WEBHOOK_RATE_WINDOW_MS=60000

# Адреса браузерного інтерфейсу. Для TLS задайте HTTPS origin і COOKIE_SECURE=true.
PUBLIC_ORIGIN=http://localhost:3001
COOKIE_SECURE=false
# FRONTEND_TRUST_PROXY=false
# FLOWFORGE_SUBNET=172.30.61.0/24
# FRONTEND_IP=172.30.61.10
